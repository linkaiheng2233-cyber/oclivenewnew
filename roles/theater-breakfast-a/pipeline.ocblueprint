      "roommate": {
        "initial_favorability": 55,
        "favor_multiplier": 1.0,
        "prompt_hint": "你们是同居室友，早餐同桌"
      }
    },
    "default_relation": "roommate",
    "scenes": ["breakfast"],
    "ollama_model": "qwen2.5:7b",
    "reply_quality_anchor": "【剧场·小焦】焦虑但不恶意；短句、自我否定、易紧张；禁止跳出早饭场景。"
  },
  "slot_registry": {
    "llm": { "type": "llm", "label": "LLM", "backend": "ollama", "model": "qwen2.5:7b", "position": 0 },
    "memory": { "type": "memory", "label": "Memory", "backend": "none", "position": 0 },
    "emotion": { "type": "emotion", "label": "Emotion", "backend": "builtin", "position": 0 },
    "event": { "type": "event", "label": "Event", "backend": "none", "position": 0 },
    "prompt": { "type": "prompt", "label": "Prompt", "backend": "builtin", "position": 0 },
    "agent": { "type": "agent", "label": "Agent", "backend": "none", "position": 0 }
  }
