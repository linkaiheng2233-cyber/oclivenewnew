# 复制为 .env.local 后填写（前端 Vite 注入，键名须以 VITE_ 开头）

# 可选：Sentry 错误上报（留空则不启用）
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# 可选：Tauri 远程/真机 dev 时 HMR 主机（见 Vite server.hmr）
# TAURI_DEV_HOST=192.168.x.x

# --- 以下为 Rust 运行时环境变量（npm run tauri:dev / cargo run -- --api 前在 shell 设置，不经过 Vite）---

# HTTP API 烟测 / CI：内存库 + Mock LLM，无需 Ollama
# OCLIVE_HTTP_API_MOCK_LLM=1

# 跳过首轮启动健康检查（槽位、角色包、DB ping、LLM 探测）
# OCLIVE_SKIP_STARTUP_HEALTH=1
# OCLIVE_SKIP_LLM_STARTUP_PROBE=1

# 可选：结构化日志级别
# RUST_LOG=info
