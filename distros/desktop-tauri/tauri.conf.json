{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A.I.Live Chat Pro",
  "version": "0.5.0",
  "identifier": "com.oclivenewnew.app",
  "mainBinaryName": "A.I.Live Chat Pro",
  "build": {
    "beforeBuildCommand": "node scripts/tauri-run.cjs build",
    "beforeDevCommand": "node scripts/tauri-run.cjs dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../chat-pro/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "A.I.Live Chat Pro",
        "width": 800,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ocliveplugin: https://ocliveplugin.localhost; connect-src 'self' tauri: http://127.0.0.1:50000 ws://127.0.0.1:50000",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": [
      "resources/roles",
      "resources/distro-profiles",
      "resources/theater",
      "resources/plugins",
      "resources/migrations",
      "resources/oclive-kernel-server",
      "resources/oclive-kernel-server.exe",
      "resources/oclive-kernel-server.oclive-manifest.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "oclive"
        ]
      }
    }
  }
}
