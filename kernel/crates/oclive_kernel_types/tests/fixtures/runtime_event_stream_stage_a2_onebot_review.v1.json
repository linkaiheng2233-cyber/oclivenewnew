  "receipt_privacy_contract": {
    "stream_safe_receipt_fields": [
      "adapter_id",
      "receipt_ref",
      "outcome",
      "attempt",
      "acknowledged_at"
    ],
    "adapter_private_encrypted_fields": [
      "destination_id",
      "message_body_while_pending",
      "provider_message_id"
    ],
    "forbidden_stream_receipt_fields": [
      "access_token",
      "user_id",
      "group_id",
      "message",
      "provider_message_id"
    ],
    "provider_locator_deleted_after_recall_window_or_session_erasure": true
  },
  "deletion_contract": {
    "recall_action": "delete_msg",
    "recall_ack_requires": ["http_status_200", "status_ok", "retcode_0"],
    "recall_is_provider_message_recall_not_privacy_erasure": true,
    "external_recall_failure_blocks_local_erasure_completion": false,
    "completion_must_report_external_recall_as_unverified": true,
    "required_local_order": [
      "block_new_deliveries_and_leases",
      "attempt_recall_when_private_locator_exists",
      "delete_adapter_private_payload_destination_and_locator",
      "verify_no_session_linked_adapter_rows",
      "report_only_aggregate_external_recall_status"
    ]
  },
  "multi_host_contract": {
    "single_delivery_owner_lease_required": true,
    "fencing_token_required_on_claim_and_receipt": true,
    "onebot_native_fencing": false,
    "automatic_failover_after_delivery_uncertain": false,
    "local_sqlite_multi_host_ready": false,
    "external_broker_trigger": "same_session_active_on_multiple_hosts"
  },
  "security_contract": {
    "credentials_outside_event_stream_trace_and_logs": true,
    "loopback_default": true,
    "remote_endpoint_requires_explicit_network_grant_and_tls": true,
    "get_with_message_query_forbidden": true,
    "plain_text_defaults_to_auto_escape": true
  },
  "review_result": {
    "protocol_mapping_feasible": true,
