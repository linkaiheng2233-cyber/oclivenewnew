{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oclive.dev/schemas/pipeline.ocblueprint.v2.schema.json",
  "title": "pipeline.ocblueprint v2 (stable; runtime_config is v3-only at runtime)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "slot_registry"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Only integer 2 is accepted (B2)."
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "author",
        "description",
        "relations",
        "default_relation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" },
        "personality": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "stubbornness",
                "clinginess",
                "sensitivity",
                "assertiveness",
                "forgiveness",
                "talkativeness",
                "warmth"
              ],
              "additionalProperties": false
            },
            {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          ]
        },
        "relations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["initial_favorability", "favor_multiplier"],
            "properties": {
              "initial_favorability": { "type": "number" },
              "favor_multiplier": { "type": "number" }
            }
          }
        },
        "default_relation": { "type": "string" },
        "scenes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "interaction_mode": { "type": "string" },
        "ollama_model": { "type": "string" },
        "min_runtime_version": { "type": "string" },
        "life_trajectory": { "type": ["object", "null"] },
        "life_schedule": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "slot_registry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "allOf": [
          { "$ref": "#/$defs/slotRegistryEntry" }
        ],
        "unevaluatedProperties": false
      }
    },
    "includes": {
      "type": "array",
      "description": "Satellite files merged at load time (relative to role pack root).",
      "items": {
        "type": "object",
        "required": ["path", "target", "mode"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[a-zA-Z0-9_./-]+$"
          },
          "target": {
            "oneOf": [
              {
                "enum": [
                  "meta.personality",
                  "meta.life_trajectory",
                  "meta.life_schedule",
                  "expert_overlay"
                ]
              },
              {
                "type": "string",
                "pattern": "^slot_registry\\.[^.]+(?:\\.[^.]+)*$"
              }
            ]
          },
          "mode": { "type": "string", "enum": ["merge", "replace"] }
        }
      }
    },
    "expert_overlay": {
      "type": "object",
      "description": "Optional pointer to expert facility files (routing_path, active_revision).",
      "additionalProperties": true
    },
    "groups": {
      "type": "object",
      "description": "Optional logical grouping of slot_registry instance keys (architecture graph).",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "type", "members"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["memory", "emotion", "event", "prompt", "llm", "agent"]
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "runtime_config": {
      "type": "object",
      "description": "v3 system configuration SSOT. Present on v2 files: ignored at load with pack validate warning; use schema_version 3 for hosts.",
      "additionalProperties": false,
      "properties": {
        "interaction_mode": { "type": "string", "enum": ["immersive", "pure_chat"] },
        "memory_config": { "type": "object" },
        "reply_quality_anchor": { "type": "string" },
        "remote_fallback_to_builtin": { "type": "boolean" },
        "dual_core": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "identity_binding": { "type": "string" },
        "evolution": { "type": "object" },
        "ollama_model": { "type": "string" },
        "remote_presence": { "type": "object" },
        "autonomous_scene": { "type": "object" }
      }
    }
  },
  "$defs": {
    "slotRegistryEntry": {
      "type": "object",
      "required": ["type", "label", "backend", "position"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "memory",
            "emotion",
            "event",
            "prompt",
            "llm",
            "agent",
            "complex_emotion"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "backend": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "plugin": { "type": ["string", "null"] },
        "plugins": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "model": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "local_memory_provider_id": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "memory" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "backend": {
                "enum": ["builtin", "remote", "directory", "local", "none"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["emotion", "event", "prompt"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "backend": {
                "enum": ["builtin", "remote", "directory", "none"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "llm" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "backend": {
                "enum": ["ollama", "remote", "directory", "none"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "agent" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "backend": {
                "enum": ["builtin", "remote", "directory", "none"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "complex_emotion" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "backend": {
                "enum": ["builtin", "remote", "directory"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "backend": { "const": "directory" } },
            "required": ["backend"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["plugin"],
                "properties": {
                  "plugin": { "type": "string", "pattern": "\\S" }
                }
              },
              {
                "required": ["plugins"],
                "properties": {
                  "plugins": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "\\S" }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": { "not": { "const": "agent" } }
            },
            "required": ["type"]
          },
          "then": {
            "not": {
              "required": ["plugin", "plugins"],
              "properties": {
                "plugin": { "type": "string", "pattern": "\\S" },
                "plugins": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "agent" },
              "backend": { "not": { "const": "directory" } }
            },
            "required": ["type", "backend"]
          },
          "then": {
            "properties": {
              "plugins": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "array", "maxItems": 0 }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "llm" },
              "backend": { "const": "ollama" }
            },
            "required": ["type", "backend"]
          },
          "then": {
            "properties": {
              "model": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "\\S" }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
