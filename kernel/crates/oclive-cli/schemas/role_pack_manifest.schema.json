{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oclive.app/schemas/role_pack_manifest.schema.json",
  "title": "oclive role pack manifest.json (subset)",
  "type": "object",
  "required": ["id", "name", "version", "author", "description", "user_relations"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "default_personality": {
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 7,
      "maxItems": 7
    },
    "scenes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "user_relations": { "type": "object", "minProperties": 1 },
    "default_relation": { "type": "string" },
    "min_runtime_version": { "type": "string" },
    "dev_only": { "type": "boolean" }
  },
  "additionalProperties": true
}
