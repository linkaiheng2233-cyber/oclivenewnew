//! `{{ safe_package_name }}` — oclive-cli 生成的可嵌入库。
{{#if kernel_linked}}
//!
//! Developer converters prepare content and assets; this basic text entry does
//! not load a rich role or synthesize unavailable product extensions.
//!
//! ```no_run
//! use {{ rust_lib_name }}::{types, MinimalRoleMessageError, MinimalRoleMessageRequest,
//!     MinimalRoleMessageResponse, OcliveKernel, PreparedMinimalRole};
//!
//! async fn basic_text(host: &OcliveKernel, definition: types::MinimalRoleDefinition,
//!     assets: Vec<Vec<u8>>) -> Result<MinimalRoleMessageResponse, MinimalRoleMessageError> {
//!     let role = PreparedMinimalRole::new("developer-role", definition, assets)?;
//!     host.process_minimal_message(&role, &MinimalRoleMessageRequest {
//!         user_message: "Hello".into(), requirements: String::new(),
//!     }).await
//! }
//! ```
{{/if}}

