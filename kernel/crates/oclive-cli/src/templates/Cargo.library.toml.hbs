[package]
name = "{{ safe_package_name }}"
version = "0.1.0"
edition = "2021"
publish = false
{{#if cargo_author}}
authors = ["{{cargo_author}}"]
{{/if}}
license = "{{cargo_license}}"
{{#if cargo_description}}
description = "{{cargo_description}}"
{{/if}}

[dependencies]
{{#if kernel_linked}}
oclive_kernel_contracts = { path = "{{ path_contracts }}" }
oclive_kernel_host = { path = "{{ path_host }}" }
oclive_kernel_runtime = { path = "{{ path_runtime }}" }
oclive_kernel_types = { path = "{{ path_types }}" }
{{else}}
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{{/if}}

[lib]
name = "{{ rust_lib_name }}"
path = "src/lib.rs"
