[package]
name = "{{ safe_package_name }}"
version = "0.1.0"
edition = "2021"
license = "{{ cargo_license }}"
{{#if cargo_author}}
authors = ["{{ cargo_author }}"]
{{/if}}
{{#if cargo_description}}
description = "{{ cargo_description }}"
{{/if}}

# Keep a generated project separate even when it is placed beneath another workspace.
[workspace]

[dependencies]
oclive_kernel_contracts = { path = "{{ path_contracts }}" }
oclive_kernel_types = { path = "{{ path_types }}" }
{{#if base_consumer_example}}
# Consumer variant: the shared runtime is an explicit author choice, not a default foundation dependency.
oclive_kernel_runtime = { path = "{{ path_runtime }}" }
{{/if}}

# Optional CLI view only; does not register or bind any implementation.
[package.metadata.oclive.wiring]
schema_version = 1
