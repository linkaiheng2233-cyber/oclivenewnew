# =============================================================================
# Oclive 无头内核（oclive_kernel_server）— 环境变量参考
# =============================================================================
# 用途：
#   • 与 delivery/docker-compose.yml 联用时，复制本文件为仓库根目录的 `.env`，
#     `docker compose -f delivery/docker-compose.yml` 会自动加载。
#   • 裸机 / systemd：复制为 `/etc/oclive/kernel.env`（权限 600），在单元文件中
#     `EnvironmentFile=/etc/oclive/kernel.env`。
#
# 生产环境强烈建议：
#   1) 显式设置 OCLIVE_ROLES_DIR、OCLIVE_DB_PATH、OCLIVE_APP_DATA_DIR；
#   2) 设置 OCLIVE_REQUIRE_EXPLICIT_PATHS=1，避免进程误用临时目录或 cwd 角色探测；
#   3) 对公网或局域网暴露监听时设置 OOCP_API_TOKEN，并配合 TLS / 防火墙。
#
# 完整部署步骤见权威文档：docs/LINUX_KERNEL_DEPLOY.md
# =============================================================================

# -----------------------------------------------------------------------------
# 一、路径（生产必设；未设时内核会用临时目录或 exe 相对路径启发式解析，不适合生产）
# -----------------------------------------------------------------------------

# 角色根目录：其下为各角色子目录（每个子目录含 manifest.json）。
# Docker Compose 模板中常映射为容器内 /roles，此处为「宿主机」路径。
# 示例（Linux）：/srv/oclive/roles
# 示例（compose 相对仓库根）：../roles
OCLIVE_ROLES_HOST_PATH=../roles

# Docker Compose：`delivery/docker-compose.yml` 已在容器内固定
#   OCLIVE_ROLES_DIR=/roles、OCLIVE_DB_PATH、OCLIVE_APP_DATA_DIR（一般无需在本文件重复）。
#
# 裸机 / systemd：必须在运行环境中导出下列三项（绝对路径），并建议开启严格模式：
#
#   export OCLIVE_ROLES_DIR=/srv/oclive/roles
#   export OCLIVE_DB_PATH=/srv/oclive/data/oclive.db
#   export OCLIVE_APP_DATA_DIR=/srv/oclive/data/app
#   export OCLIVE_REQUIRE_EXPLICIT_PATHS=1
#
# 未设置时的内核行为（不推荐生产）：
#   • OCLIVE_ROLES_DIR：exe/cwd 启发式探测角色目录
#   • OCLIVE_DB_PATH：系统临时目录下 oclive_api_<端口>.db（易丢）
#   • OCLIVE_APP_DATA_DIR：派生自 DB 父目录下的子目录
#
# OCLIVE_REQUIRE_EXPLICIT_PATHS=1 时，上述三项任一缺失或为空则启动失败（退出码 2）。
# OCLIVE_REQUIRE_EXPLICIT_PATHS=1

# -----------------------------------------------------------------------------
# 二、HTTP / OOCP 网络
# -----------------------------------------------------------------------------

# 监听端口（容器内外一致时常用 48888）。
OOCP_API_PORT=48888

# 监听地址。安全默认 127.0.0.1；Docker 端口映射需容器内监听 0.0.0.0。
# 裸机仅本机访问：127.0.0.1；配合反向代理可对代理监听 127.0.0.1，由代理对外 TLS。
OOCP_API_BIND=0.0.0.0

# compose 将容器 48888 映射到宿主机的端口（仅 compose / 文档用，内核不读此变量）。
OOCP_PUBLISH_PORT=48888

# 非空时：REST（/chat、/role-feedback*）与 OOCP WebSocket 均需
#   Authorization: Bearer <与此处完全一致的 token>
# /health 始终无需鉴权，便于负载均衡与外部探活。
# 生产（尤其 OOCP_API_BIND=0.0.0.0）务必设置强随机密钥。
# OOCP_API_TOKEN=请替换为强随机字符串

# -----------------------------------------------------------------------------
# 三、日志与诊断
# -----------------------------------------------------------------------------

# tracing / env_logger：error | warn | info | debug | trace
RUST_LOG=info

# 仅调试内核冷启动分段日志时可加：RUST_LOG=oclive_startup=info,info

# -----------------------------------------------------------------------------
# 四、可选：侧车 LLM / 远程插件（按角色包 plugin_backends 与文档启用）
# -----------------------------------------------------------------------------

# OCLIVE_REMOTE_LLM_URL=http://127.0.0.1:8765/rpc
# OCLIVE_REMOTE_PLUGIN_URL=http://127.0.0.1:8765/rpc
# OCLIVE_CLOUD_LLM_BASE_URL=...
# OCLIVE_CLOUD_LLM_API_KEY=...

# -----------------------------------------------------------------------------
# 五、运维脚本（见 scripts/）常用变量
# -----------------------------------------------------------------------------

# health_check.sh：探活 URL，默认 http://127.0.0.1:48888
# OCLIVE_HEALTH_URL=http://127.0.0.1:48888

# backup_kernel_db.sh：备份目录与保留天数
# OCLIVE_BACKUP_DIR=/var/backups/oclive
# OCLIVE_BACKUP_KEEP_DAYS=14
