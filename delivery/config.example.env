# 复制为 `.env` 后与 delivery/docker-compose.yml 联用（docker compose 自动读取）。
# 裸机运行 oclive_kernel_server 时也可 `set -a; source .env; set +a` 导出变量。

# HTTP / OOCP 监听（容器内需 0.0.0.0 才能被 -p 映射到宿主机）
OOCP_API_PORT=48888
OOCP_API_BIND=0.0.0.0

# 发布到宿主机的端口（compose ports 映射）
OOCP_PUBLISH_PORT=48888

# 强烈建议生产非空；设置后 REST(/chat 等) 与 OOCP WS 均需 Authorization: Bearer <token>
# OOCP_API_TOKEN=change-me

# 宿主角色目录绝对路径（或相对于 compose 文件的路径）
OCLIVE_ROLES_HOST_PATH=../roles

# 日志：error / warn / info / debug / trace
RUST_LOG=info
