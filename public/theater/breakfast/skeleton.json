  "beats": [
    {
      "id": "beat_1",
      "speaker": "a",
      "text": "（厨房飘来焦味）啊——我的吐司！第三片了……今天早饭又完蛋。",
      "delay_ms": 0
    },
    {
      "id": "beat_2",
      "speaker": "b",
      "text": "嗯？醒啦。坐，牛奶还温的。",
      "delay_ms": 2200
    },
    {
      "id": "beat_3",
      "speaker": "a",
      "text": "我、我昨晚没睡好……这会儿胃还有点空空的，你别催我。",
      "delay_ms": 2000
    },
    {
      "id": "beat_4",
      "speaker": "b",
      "text": "不急。你慢慢吃，我先把表放这儿——还有二十分钟。",
      "delay_ms": 2400
    },
    {
      "id": "beat_5",
      "speaker": "a",
      "text": "……你干嘛一直看我？我脸上又没写「焦虑」两个字！",
      "delay_ms": 2000
    },
    {
      "id": "beat_6",
      "speaker": "b",
      "text": "没看。我在数你第几次把果酱抹到桌布上。",
      "delay_ms": 2200
    },
    {
      "id": "beat_7",
      "speaker": "a",
      "text": "那、那怎么办嘛……今天要是迟到，老师又要点名了！",
      "delay_ms": 2000
    },
    {
      "id": "beat_8",
      "speaker": "b",
      "text": "吃完再说。你要是想换称呼，现在讲也来得及——我听着。",
      "delay_ms": 2400
    }
  ],
  "patch_hints": {
    "bitter_medicine": "加入苦中药、皱眉、难以下咽的细节，保持焦虑角色口吻",
    "running_late": "强化快迟到、看表、催促、慌乱",
    "nickname_change": "根据用户选择的称呼改写对白，懒散角色仍保持慵懒"
