{
  "name": "oclivenewnew",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "distros/shared",
    "distros/chat-pro",
    "distros/theater"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @oclive/chat-pro",
    "dev:web": "npm run dev -w @oclive/chat-pro",
    "dev:probe": "node scripts/dev-probe.mjs",
    "verify:ui": "node scripts/verify-frontend-patches.mjs",
    "tauri:dev:verify": "npm run verify:ui && npm run tauri:dev",
    "push:origin": "git push origin main && git push origin --tags",
    "tauri:before-dev": "node scripts/tauri-npm.cjs dev",
    "tauri:before-build": "node scripts/tauri-npm.cjs build",
    "build": "concurrently \"npm run build:plugin-bridge\" \"npm run build -w @oclive/chat-pro\"",
    "build:plugin-bridge": "vite build --config vite.plugin-bridge.config.ts && node scripts/copy-plugin-bridge.mjs",
    "build:e2e": "npm run build:e2e -w @oclive/chat-pro",
    "build:analyze": "npm run build:analyze -w @oclive/chat-pro",
    "preview": "npm run preview -w @oclive/chat-pro",
    "tauri": "tauri",
    "tauri:dev": "node scripts/with-windows-rc-path.mjs tauri dev --config distros/desktop-tauri/tauri.conf.json",
    "tauri:dev:split": "node scripts/with-windows-rc-path.mjs node scripts/tauri-dev-split.mjs",
    "tauri:dev:theater": "node scripts/with-windows-rc-path.mjs node scripts/theater-env.mjs dev",
    "tauri:build": "node scripts/bundle-kernel-for-tauri.mjs && node scripts/with-windows-rc-path.mjs tauri build --config distros/desktop-tauri/tauri.conf.json",
    "tauri:build:theater": "node scripts/with-windows-rc-path.mjs node scripts/theater-env.mjs build",
    "bundle-kernel:tauri": "node scripts/bundle-kernel-for-tauri.mjs",
    "check:rust:fmt": "cargo fmt --all -- --check",
    "check:rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check:rust:test": "cargo test --workspace --lib",
    "check:rust:integration": "node scripts/ensure-tauri-dist.mjs && cargo test --locked --workspace --tests",
    "check:rust:test:all": "cargo test --workspace",
    "check:rust": "node scripts/ensure-tauri-dist.mjs && node scripts/check-domain-layering.mjs && node scripts/check-changelog-parity.mjs && node scripts/check-doc-mirror.mjs && npm run check:rust:fmt && npm run check:rust:clippy && npm run check:rust:test",
    "check:license": "node scripts/check-license-readiness.mjs",
    "check:debt-marathon": "node scripts/check-debt-marathon.mjs",
    "test:cursor-marathon-hook": "node scripts/test-cursor-marathon-hook.mjs",
    "check": "npm run build && npm run check:rust",
    "check:release": "npm run build && npm run test:unit && npm run verify:ui && npm run verify:shared-i18n && npm run check:rust:fmt && npm run check:rust:clippy && npm run check:rust:test:all",
    "check:ci-local": "node scripts/dimension5-acceptance.mjs --ci && npm run check && npm run check:rust:integration",
    "verify:shared-i18n": "node scripts/verify-shared-i18n.mjs",
    "test:distro-profile-mirror": "node scripts/diff-vscode-distro-profile.mjs",
    "test:distro:smoke": "npm run test:distro-profile-mirror && npm run test:e2e:distro-kernel && npm run test:e2e:tauri-bundled-kernel",
    "scaffold:ui-plugin": "node scripts/scaffold-ui-slot-plugin.mjs",
    "test:unit": "npm run test:unit -w @oclive/desktop-shared && npm run test:unit -w @oclive/chat-pro",
    "lint": "eslint distros/chat-pro/src distros/shared/src vite.base.config.ts",
    "format": "prettier --write .",
    "test:e2e:core-api-restart": "node scripts/e2e-core-api-restart.mjs",
    "test:e2e:cross-host": "node scripts/e2e-cross-host-memory.mjs",
    "test:e2e:distro-kernel": "node scripts/e2e-distro-kernel.mjs --scenario all",
    "test:theater:smoke": "node scripts/theater-prompt-drift.mjs && node scripts/theater-stranger-proxy.mjs && npm run test:unit -w @oclive/theater",
    "test:e2e:tauri-bundled-kernel": "node scripts/e2e-tauri-bundled-kernel.mjs",
    "test:e2e:preview": "playwright test",
    "test:e2e:tauri-native": "playwright test distros/chat-pro/e2e/tauri-native.spec.ts"
  },
  "dependencies": {
    "@sentry/vue": "^10.47.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "idb-keyval": "^6.2.1",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.2"
  },
  "overrides": {
    "defu": "6.1.5",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.8.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "vue3-sfc-loader": "^0.9.5",
    "webdriverio": "^9.27.1"
  }
}
