{
  "name": "oclivenewnew",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite",
    "dev:probe": "node scripts/dev-probe.mjs",
    "verify:ui": "node scripts/verify-frontend-patches.mjs",
    "tauri:dev:verify": "npm run verify:ui && npm run tauri:dev",
    "push:origin": "git push origin main && git push origin --tags",
    "tauri:before-dev": "node scripts/tauri-npm.cjs dev",
    "tauri:before-build": "node scripts/tauri-npm.cjs build",
    "build": "concurrently \"npm run build:plugin-bridge\" \"vite build\"",
    "build:plugin-bridge": "vite build --config vite.plugin-bridge.config.ts && node scripts/copy-plugin-bridge.mjs",
    "build:e2e": "vite build --mode e2e",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check:rust:test:all": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust": "npm run check:rust:fmt && npm run check:rust:clippy && npm run check:rust:test",
    "check:license": "node scripts/check-license-readiness.mjs",
    "check": "npm run build && npm run check:rust",
    "check:release": "npm run build && npm run test:unit && npm run verify:ui && npm run verify:shared-i18n && npm run check:rust:fmt && npm run check:rust:clippy && npm run check:rust:test:all",
    "verify:shared-i18n": "node scripts/verify-shared-i18n.mjs",
    "scaffold:ui-plugin": "node scripts/scaffold-ui-slot-plugin.mjs",
    "test:unit": "vitest run",
    "lint": "eslint src vite.config.ts e2e-mock",
    "format": "prettier --write .",
    "test:e2e:core-api-restart": "node scripts/e2e-core-api-restart.mjs",
    "test:e2e:preview": "playwright test",
    "test:e2e:tauri-native": "playwright test e2e/tauri-native.spec.ts"
  },
  "dependencies": {
    "@sentry/vue": "^10.47.0",
    "@tauri-apps/api": "^1.5.6",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "idb-keyval": "^6.2.1",
    "mitt": "^3.0.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.2",
    "vue3-sfc-loader": "^0.9.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "1.5.14",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.8.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "webdriverio": "^9.27.1"
  }
}
