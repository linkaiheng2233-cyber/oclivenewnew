//! `{{ safe_package_name }}` — oclive-cli 生成的占位内核（无头可执行）。
//!
//! 运行方式：在本目录执行 `cargo run`。
{{#if monolith_enabled}}
//! 高耦合构建使用独立入口 **`src/main_monolith.rs`**（`{{ safe_package_name }}-monolith` 二进制），见 `Cargo.toml` 中 `[[bin]]`。
{{/if}}

fn kernel_bench_iterations() -> u32 {
    std::env::var("OCLIVE_KERNEL_BENCH_ITERS")
        .ok()
        .and_then(|s| s.parse().ok())
        .filter(|&n| n > 0)
        .unwrap_or(1)
        .min(1_000_000)
}

fn init_kernel_tracing() {
    use tracing_subscriber::EnvFilter;
    let filter = EnvFilter::try_from_default_env()
        .unwrap_or_else(|_| EnvFilter::new("info"));
    let _ = tracing_subscriber::fmt()
        .with_env_filter(filter)
        .with_target(false)
        .try_init();
}

#[allow(dead_code)]
fn run_stub_kernel() {
    tracing::info!("{{ safe_package_name }} — stub kernel (oclive-cli)");
    let settings = std::path::Path::new("roles/default/settings.json");
    if settings.exists() {
        let n = std::fs::read_to_string(settings).map(|s| s.len()).unwrap_or(0);
        tracing::info!("roles/default/settings.json: {} bytes", n);
    } else {
        tracing::info!("(未找到 roles/default/settings.json，使用 --preset full 或交互生成示例角色包)");
    }
}

fn main() {
    init_kernel_tracing();
    let n = kernel_bench_iterations();
    for _ in 0..n {
        run_stub_kernel();
    }
}
