[package]
name = "{{ safe_package_name }}"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
{{#if kernel_linked}}
oclive_kernel_runtime = { path = "{{ path_runtime }}" }
{{else}}
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{{/if}}

[lib]
name = "{{ rust_lib_name }}"
path = "src/lib.rs"
