[package]
name = "{{ safe_package_name }}"
version = "0.1.0"
edition = "2021"
publish = false

# 占位内核：可独立 cargo build。接入 oclive_kernel_runtime 时在此添加 path / git 依赖。
[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
{{#if monolith_enabled}}
oclive_monolith_builtin = { path = "vendor/oclive_monolith_builtin" }

[features]
default = []
monolith = []

[[bin]]
name = "{{ safe_package_name }}"
path = "src/main.rs"

[[bin]]
name = "{{ safe_package_name }}-monolith"
path = "src/main_monolith.rs"
required-features = ["monolith"]
{{else}}
[[bin]]
name = "{{ safe_package_name }}"
path = "src/main.rs"
{{/if}}
