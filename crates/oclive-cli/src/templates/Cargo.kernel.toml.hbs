[package]
name = "{{ safe_package_name }}"
version = "0.1.0"
edition = "2021"
publish = false

# 占位内核：可独立 cargo build。接入 oclive_kernel_runtime 时在此添加 path / git 依赖。
[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[[bin]]
name = "{{ rust_lib_name }}"
path = "src/main.rs"
