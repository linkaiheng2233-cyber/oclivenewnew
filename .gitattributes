# SQLx migration checksums are content-sensitive; keep LF in working tree on Windows.
src-tauri/migrations/*.sql text eol=lf
# CI shell scripts must stay LF — CRLF makes `set -o pipefail` fail on Linux runners.
*.sh text eol=lf
scripts/*.sh text eol=lf
# Scaffold source digests must match fresh checkouts on Windows and Unix.
examples/scaffold-kernel-base-custom/package/** text eol=lf
# Markdown is read by documentation tooling and hashed by content; keep LF in the working tree
# so working-tree bytes match the index blob on every platform.
*.md text eol=lf
