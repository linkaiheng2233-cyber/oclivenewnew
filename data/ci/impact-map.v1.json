    "oclive.kernel-contracts": ["oclive.kernel-runtime", "oclive.cli", "oclive.desktop", "oclive.shared", "oclive.chat-pro", "oclive.theater", "oclive.plugins", "oclive.roles", "oclive.examples"],
    "oclive.kernel-runtime": ["oclive.cli", "oclive.desktop", "oclive.chat-pro", "oclive.theater", "oclive.plugins", "oclive.roles", "oclive.examples"],
    "oclive.desktop": ["oclive.shared", "oclive.chat-pro", "oclive.theater", "oclive.plugins", "oclive.roles"],
    "oclive.shared": ["oclive.chat-pro", "oclive.theater", "oclive.plugins"],
    "oclive.chat-pro": ["oclive.plugins", "oclive.roles"],
    "oclive.plugins": ["oclive.chat-pro"],
    "oclive.roles": ["oclive.chat-pro", "oclive.desktop"],
    "oclive.ci-planner": ["oclive.cli", "oclive.repo-tooling"],
    "oclive.scaffold": ["oclive.cli"]
  },
  "risk_overrides": [
    {
      "id": "ci-control-plane",
      "selectors": [
        { "kind": "prefix", "value": ".github/workflows" },
        { "kind": "prefix", "value": "data/ci" },
        { "kind": "prefix", "value": "kernel/crates/oclive_ci_plan" },
        { "kind": "exact", "value": "kernel/crates/oclive-cli/src/ci_impact_cmd.rs" },
        { "kind": "exact", "value": "scripts/ci-execution-policy.mjs" }
      ],
      "full": true,
      "reason": "CI selection logic or policy changed"
    },
    {
      "id": "workspace-dependencies",
      "selectors": [
        { "kind": "exact", "value": "Cargo.toml" }, { "kind": "exact", "value": "Cargo.lock" },
        { "kind": "exact", "value": "package.json" }, { "kind": "exact", "value": "package-lock.json" }
      ],
      "full": true,
      "reason": "workspace membership or dependency graph changed"
    },
    {
      "id": "release-governance",
      "selectors": [
        { "kind": "exact", "value": "scripts/dimension5-acceptance.mjs" },
        { "kind": "exact", "value": "scripts/check-domain-layering.mjs" }
      ],
      "force_profiles": ["repo-governance"],
      "reason": "central quality gate changed"
    }
