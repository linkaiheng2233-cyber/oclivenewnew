{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@oclive/shared/*": ["distros/shared/src/*"],
      "@oclive/theater/*": ["distros/theater/src/*"],
      "@oclive/chat-pro/*": ["distros/chat-pro/src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "distros/shared/src/**/*.ts",
    "distros/shared/src/**/*.vue",
    "distros/chat-pro/src/**/*.ts",
    "distros/chat-pro/src/**/*.vue",
    "distros/theater/src/**/*.ts",
    "distros/theater/src/**/*.vue"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
