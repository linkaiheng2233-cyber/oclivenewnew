{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "distros/shared/src/**/*.ts",
    "distros/shared/src/**/*.vue",
    "distros/chat-pro/src/**/*.ts",
    "distros/chat-pro/src/**/*.vue",
    "distros/theater/src/**/*.ts",
    "distros/theater/src/**/*.vue"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
